# .env.example
# =============================================================================
# KiranaIQ Environment Configuration
# Copy this file: cp .env.example .env
# Fill in the values below, then restart both servers.
# =============================================================================

# ── Runtime mode ──────────────────────────────────────────────────────────
# "demo"       → No API keys needed. Mock providers return realistic data.
# "production" → Real GPT-4o + Google Places calls. Requires keys below.
KIRANAIQ_MODE=demo

# ── OpenAI (required when KIRANAIQ_MODE=production) ───────────────────────
OPENAI_API_KEY=sk-...

# ── Google Maps (required when KIRANAIQ_MODE=production) ──────────────────
GOOGLE_PLACES_KEY=AIza...

# ── Streamlit: backend URL (set this on Streamlit Cloud) ──────────────────
# Leave blank for local development — defaults to http://localhost:8000
KIRANAIQ_BACKEND_URL=